# Copy to .env and fill in. Never commit .env.
# Google Gemini API key (free tier, no billing) from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Main agent model (function calling). Any current Gemini Flash model.
GEMINI_MODEL=gemini-flash-latest
# Comma-separated models tried in order when the primary is rate-limited or out of its
# free DAILY quota (free tier quotas are per model, e.g. ~20 requests/day for the newest Flash).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Cheaper chain for simple structured calls (parse_request, owner role-play)
GEMINI_LIGHT_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash
# Gemini 3 thinking level: minimal | low | medium | high (lower = faster). Empty = model default.
GEMINI_THINKING_LEVEL=low
# Nominatim / Overpass usage policy requires an identifying User-Agent
OSM_USER_AGENT=PGFinderAgent/0.1 (+https://github.com/your-name/pg-finder-agent)
# Set to "false" to skip the Overpass (OpenStreetMap) supplement search
ENABLE_OVERPASS=true
