# Copy to .env and fill in. Never commit .env.
# Google Gemini API key (free tier, no billing required) from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Geoapify Places API key (optional free tier, no credit card required) from https://www.geoapify.com
GEOAPIFY_API_KEY=

# Demo mode: false by default. When false, only real live public listings are searched.
# When true, loads sample listings from data/listings.json.
DEMO_MODE=false

# Main agent model (function calling).
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated fallback models tried in order when the primary is rate-limited
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-flash-latest

# Cheaper chain for simple structured calls
GEMINI_LIGHT_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash

# Gemini thinking level: minimal | low | medium | high
GEMINI_THINKING_LEVEL=low

# Nominatim / Overpass usage policy requires an identifying User-Agent
OSM_USER_AGENT=StudentPGFinderProjectApp/2.0 (student.pg.finder.app@gmail.com)

# Set to "false" to skip OpenStreetMap Overpass search
ENABLE_OVERPASS=true
